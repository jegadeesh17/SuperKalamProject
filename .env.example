# Environment variables for SuperKalamProject.
# Copy this file to .env and fill in the secrets. Settings are read by
# configs/settings.py (pydantic-settings); unknown variables are ignored.

# API key for the LLM gateway. The variable name says OPENROUTER, but the default
# endpoint below is Groq, so use a Groq key (https://console.groq.com/keys).
# Without it the evaluator, feedback and model-answer calls fail with HTTP 422.
OPENROUTER_API_KEY=

# Model identifier sent to the gateway. Groq retires models periodically; check
# https://console.groq.com/docs/models if calls start failing.
# OPENROUTER_MODEL=openai/gpt-oss-120b

# Chat-completions endpoint. Default is Groq's OpenAI-compatible endpoint; an
# OpenRouter URL also works with a matching key and model.
# OPENROUTER_BASE_URL=https://api.groq.com/openai/v1/chat/completions

# SQLAlchemy URL for attempts, topics, PYQs and rubrics.
# Default: sqlite:///<project root>/db/superkalam.db
# DATABASE_URL=sqlite:///db/superkalam.db

# Directory of the ChromaDB persistent store. Default: <project root>/chroma_db
# CHROMA_DIR=chroma_db

# ChromaDB collection name for the PYQ embeddings.
# CHROMA_COLLECTION=superkalam_pyqs

# Sentence-transformers model used to embed questions.
# EMBEDDING_MODEL=all-MiniLM-L6-v2

# Defined in this file but not read by the current code (the setting is named CHROMA_DIR).
# CHROMA_PERSIST_DIR=chroma_db
